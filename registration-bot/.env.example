# ---- Telegram ----
# BotFather'dan olingan token (kodga yozmang, faqat shu fayl yoki hosting sirlarida saqlang)
BOT_TOKEN=

# Majburiy kanallar: ikkala kanalda ham bot ADMIN bo'lishi shart
CHANNEL_1_ID=@kanal_username
CHANNEL_1_URL=https://t.me/kanal_username
CHANNEL_1_NAME=1-kanal
CHANNEL_2_ID=-1001234567890
CHANNEL_2_URL=https://t.me/ikkinchi_kanal
CHANNEL_2_NAME=2-kanal

# ---- Google Sheets ----
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Registrations
# 1-usul: JSON fayldagi client_email va private_key alohida
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key qiymati: qo'shtirnoqsiz, -----BEGIN... dan -----END... gacha (\n belgilari qolsa ham bo'ladi)
GOOGLE_PRIVATE_KEY=
# 2-usul (osonroq): JSON faylning BUTUN mazmuni bitta qiymat sifatida. Shunda yuqoridagi ikkitasi kerak emas.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Admin va umumiy ----
# Vergul bilan ajratilgan Telegram ID lar
ADMIN_IDS=
TIMEZONE=Asia/Tashkent
LOG_LEVEL=info
SESSION_TTL_HOURS=24
# Tugallanmagan jarayonlar saqlanadigan fayl (Docker'da /app/data ichida bo'lsin)
SESSION_FILE=./data/sessions.json

# Yoqilgan maydonlar. first_name va phone doim yoqilgan bo'ladi.
# Mumkin bo'lganlar: first_name,last_name,phone,birth_date,gender,region,district,additional_info
REGISTRATION_FIELDS=first_name,last_name,phone,birth_date,gender,region,district,additional_info

# Render kabi hostinglar uchun: servis shu portni tinglaydi (Render o'zi PORT beradi). VPS'da kerak emas.
# PORT=10000

# Ixtiyoriy: viloyat va tumanlar ro'yxati. Bo'sh qoldirilsa, foydalanuvchi matn yozadi.
# REGIONS_JSON={"Qashqadaryo":["Qarshi","Shahrisabz","Kitob"],"Toshkent":["Yunusobod","Chilonzor"]}
REGIONS_JSON=
